{
  "name": "wtf-plugin-nsfw",
  "version": "1.0.1",
  "description": "content filter for wikipedia articles",
  "license": "MIT",
  "repository": "github:spencermountain/wtf-plugin-nsfw",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./builds/wtf-plugin-nsfw.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/wtf-plugin-nsfw.cjs"
      },
      "default": {
        "types": "./types/index.d.ts",
        "default": "./builds/wtf-plugin-nsfw.mjs"
      }
    }
  },
  "main": "./builds/wtf-plugin-nsfw.cjs",
  "module": "./builds/wtf-plugin-nsfw.mjs",
  "types": "./types/index.d.cts",
  "sideEffects": false,
  "scripts": {
    "watch": "node --watch ./scratch.js",
    "test": "tape \"./tests/**/*.test.js\" | tap-dancer",
    "testb": "TESTENV=prod tape \"./tests/**/*.test.js\" | tap-dancer",
    "test:types": "tsc -p tests/types",
    "build": "rollup -c",
    "lint": "eslint ."
  },
  "files": [
    "builds",
    "types"
  ],
  "dependencies": {
    "eslint": "^10.11.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "eslint-plugin-regexp": "3.3.1",
    "rollup": "4.63.4",
    "tap-dancer": "^0.4.0",
    "tape": "^5.10.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "wtf_wikipedia": "^10.0.0"
  },
  "unpkg": "./builds/wtf-plugin-nsfw.min.js",
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  }
}
