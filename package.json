{
  "name": "wtf-plugin-nsfw",
  "description": "content filter for wikipedia articles",
  "version": "0.1.0",
  "main": "./builds/wtf-plugin-nsfw.js",
  "unpkg": "./builds/wtf-plugin-nsfw.min.js",
  "module": "./builds/wtf-plugin-nsfw.mjs",
  "author": "Spencer Kelly (spencermountain)",
  "homepage": "https://github.com/spencermountain/wtf_wikipedia/plugins/nsfw#readme",
  "scripts": {
    "watch": "amble ./scratch.js",
    "test": "tape ./tests/**/*.test.js | tap-dancer",
    "testb": "TESTENV=prod tape ./tests/**/*.test.js | tap-dancer",
    "build": "rollup -c"
  },
  "files": [
    "builds"
  ],
  "prettier": {
    "trailingComma": "none",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "dependencies": {},
  "peerDependencies": {
    "wtf_wikipedia": "^8.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "eslint-plugin-regexp": "3.1.0",
    "rollup": "4.62.2",
    "tap-dancer": "^0.2.0",
    "tape": "^4.11.0",
    "wtf_wikipedia": "^8.1.1"
  },
  "licence": "MIT"
}
